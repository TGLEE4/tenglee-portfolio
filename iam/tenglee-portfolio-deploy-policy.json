{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployWebsiteFilesToS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::tenglee.dev",
        "arn:aws:s3:::tenglee.dev/*"
      ]
    },
    {
      "Sid": "InvalidateCloudFrontCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::*:distribution/E3VKOSMP7R9W0J"
    }
  ]
}